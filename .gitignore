# ============================================================
# PathoVerse AI - Git Ignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/

# Large datasets
data/raw/
data/processed/

# Downloaded / generated model weights
models/**/*
!models/
!models/pcam_classification/
!models/pcam_classification/*.pt

# Third-party repositories
/external/

# Experiment tracking / runtime databases
mlruns/
mlflow.db

# Runtime logs
logs/
*.log

# Generated temporary results
# Individual final benchmark artifacts are force-added to Git.
results/tmp/
results/cache/

# Generated embedding metadata
data/metadata/embeddings/
data/metadata/patchcamelyon/*_embeddings.json
data/metadata/patchcamelyon/*_embedding_summary.json
data/metadata/wsi/

# Frontend / IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Temporary backups
*.backup
*.bak
*.tmp
*~

# Python tooling
.ruff_cache/
.mypy_cache/
