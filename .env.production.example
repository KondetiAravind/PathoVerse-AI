# =========================================================
# PathoVerse AI - Production Configuration
# =========================================================

PATHOVERSE_ENV=production

PATHOVERSE_HOST=0.0.0.0
PATHOVERSE_PORT=8000

PATHOVERSE_LOG_LEVEL=INFO

PATHOVERSE_CORS_ORIGINS=http://localhost:3000
PATHOVERSE_CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
PATHOVERSE_CORS_HEADERS=*

# ---------------------------------------------------------
# Data paths
# ---------------------------------------------------------

PATHOVERSE_DATA_ROOT=/app/data
PATHOVERSE_RAW_DATA_DIR=/app/data/raw
PATHOVERSE_PROCESSED_DATA_DIR=/app/data/processed
PATHOVERSE_METADATA_DIR=/app/data/metadata
PATHOVERSE_RESULTS_DIR=/app/results

# ---------------------------------------------------------
# Hugging Face
# ---------------------------------------------------------

HF_HOME=/app/data/huggingface