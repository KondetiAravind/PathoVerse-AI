# ============================================================
# PathoVerse AI - Local Development Configuration
# ============================================================

PATHOVERSE_APP_NAME=PathoVerse AI
PATHOVERSE_APP_VERSION=0.4.0
PATHOVERSE_ENV=development

# Backend
PATHOVERSE_HOST=127.0.0.1
PATHOVERSE_PORT=8000
PATHOVERSE_LOG_LEVEL=INFO

# Frontend / CORS
PATHOVERSE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PATHOVERSE_CORS_ALLOW_CREDENTIALS=true
PATHOVERSE_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
PATHOVERSE_CORS_ALLOW_HEADERS=*

# Local project paths
PATHOVERSE_PROJECT_ROOT=.
PATHOVERSE_DATA_ROOT=./data
PATHOVERSE_RAW_ROOT=./data/raw
PATHOVERSE_PROCESSED_ROOT=./data/processed
PATHOVERSE_METADATA_ROOT=./data/metadata
PATHOVERSE_RESULTS_ROOT=./results
PATHOVERSE_MODELS_ROOT=./models

# API authentication
# Leave empty for local development unless authentication is enabled.
PATHOVERSE_API_KEY=

# Hugging Face
# Required only for models that require Hugging Face access.
HF_TOKEN=
HF_HOME=./data/huggingface
